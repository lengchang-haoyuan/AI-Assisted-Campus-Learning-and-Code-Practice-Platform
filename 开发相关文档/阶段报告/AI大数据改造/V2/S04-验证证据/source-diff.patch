+.workflow-node-result__metadata { display: flex; align-items: start; flex-wrap: wrap; gap: 12px 24px; margin: 16px 0 24px; color: var(--muted); font-size: 12px; }
+.workflow-node-result__metadata strong { margin-left: 4px; font-weight: 400; color: var(--ink); font-variant-numeric: tabular-nums; }
+.workflow-node-result__metadata details { min-width: 0; }
+.workflow-node-result__metadata summary { cursor: pointer; }
+.workflow-node-result__metadata code { display: block; max-width: 100%; padding-top: 8px; font-size: 11px; overflow-wrap: anywhere; }
+.workflow-node-result__empty { padding: 32px 20px; margin: 0; color: var(--muted); background: var(--paper, #f9faf5); line-height: 1.8; border-radius: 8px; }
+.workflow-node-result__pagination { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--line); }
+.workflow-node-result__pagination span { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
+.workflow-node-result__pagination button { min-height: 44px; }
+.workflow-execution button:disabled { cursor: default; opacity: .5; }
+.workflow-execution :is(button, summary, select):focus-visible { outline: 3px solid #5a947a; outline-offset: -3px; }
 .workflow-context-status { margin: 16px 0; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; gap: 18px; background: #edf7f2; border: 1px solid #b9ddcf; border-radius: 8px; }
 .workflow-context-status[data-state='stale'], .workflow-context-status[data-state='missing'] { color: #73420d; background: #fff7e8; border-color: #ebd19e; }
 .workflow-context-status[data-state='error'] { color: #8f2d35; background: var(--danger-soft); border-color: #efc3c7; }
 .workflow-context-status p { margin: 5px 0 0; line-height: 1.6; }
