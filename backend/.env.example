APP_NAME=ScholarHub API
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 示例：mysql+pymysql://scholarhub_user:local_password@127.0.0.1:3306/scholarhub?charset=utf8mb4
DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_CONNECT_TIMEOUT_SECONDS=5
AI_TOTAL_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_RETRY_BASE_DELAY_SECONDS=0.25
AI_MAX_RETRY_DELAY_SECONDS=2
